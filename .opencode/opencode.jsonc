{
  "$schema": "https://opencode.ai/config.json",
  // ourapp local dev: route Anthropic traffic through our local LiteLLM Gateway.
  // The Gateway issues virtual keys via Billing service; paste yours into "apiKey".
  // The patched anthropic provider auto-detects custom baseURL and switches to
  // Authorization: Bearer (required by LiteLLM /v1/messages).
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://localhost:4000",
        // Replace with the litellm_key returned by Billing /me — for the test user
        // it's the value of subscription.litellmKey (e.g. sk-nk7YaSwLZijpZj9Gyyisgw).
        "apiKey": "sk-REPLACE-WITH-VIRTUAL-KEY-FROM-BILLING",
      },
    },
  },
  // Document parsing / DOCX generation tools — exposes `parse_document` and
  // `generate_docx` to the agent. Without this the agent cannot read attached
  // contracts or produce Word output.
  "plugin": ["@ourapp/doc-tools/plugin"],
  "permission": {},
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
