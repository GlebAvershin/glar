{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    // DOM lib needed because we import from @opencode-ai/plugin and
    // @opencode-ai/sdk, whose source uses HeadersInit/BodyInit/Headers.
    // DOM.Iterable adds iterator methods on Headers (.entries(), .keys(), etc.).
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*", "test/**/*"]
}
